{
  "name": "motes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "turbo": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@biomejs/biome": "catalog:",
    "vitest": "catalog:",
    "jsdom": "catalog:",
    "@testing-library/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.test.json",
    "lint": "pnpm boundaries && biome check .",
    "boundaries": "node scripts/check-boundaries.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
