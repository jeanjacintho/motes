      "table": "pairing_state",
      "name": "pairing_code_check",
      "value": "(\"code_hash\" IS NULL AND \"expires_at\" IS NULL) OR (\"code_hash\" IS NOT NULL AND \"code_hash\" ~ '^[0-9a-f]{64}$' AND \"expires_at\" IS NOT NULL)",
