{
  "name": "@motes/db",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .turbo/typecheck.tsbuildinfo",
    "db:generate": "pnpm build && node dist/cli.js generate",
    "db:migrate": "pnpm build && node dist/cli.js migrate",
    "db:check": "pnpm build && node dist/cli.js check"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./test-global-setup": {
      "types": "./dist/test-global-setup.d.ts",
      "import": "./dist/test-global-setup.js"
    }
  },
  "dependencies": {
    "@motes/protocol": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/emscripten": "catalog:",
    "drizzle-kit": "catalog:",
    "mysql2": "catalog:",
    "vitest": "catalog:"
  }
}
